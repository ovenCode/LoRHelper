<Window x:Class="desktop.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop"
        xmlns:controls="clr-namespace:desktop.Controls"
        xmlns:vms="clr-namespace:desktop.ViewModels"
        mc:Ignorable="d"
        Title="CustomMessageBoxWindow"
        MinHeight="150"
        MaxWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStyle="ToolWindow">
    <Grid Background="#FFDC840F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="messageTB"
                   FontWeight="DemiBold"
                   TextAlignment="Center"
                   MinHeight="80"
                   Margin="0,20,0,20"
                   MaxWidth="380"
                   Text="{Binding Message}"
                   TextWrapping="WrapWithOverflow" />
        <controls:UniformStackPanel Orientation="Horizontal"
                                    Grid.Row="1"
                                    VerticalAlignment="Center"
                                    ItemSpacing="10"
									Margin="0,0,0,20"
                                    HorizontalAlignment="Center">
            <Button x:Name="okBtn"
                    Width="60"
                    Content="OK"
                    VerticalAlignment="Stretch"
                    Command="{Binding OkCommand}"
                    Visibility="{Binding OkCommand, Converter={StaticResource MessageBoxButtonsConverter}}" />
            <Button x:Name="cancelBtn"
                    Width="60"
                    Content="Cancel"
                    VerticalAlignment="Stretch"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding CancelCommand, Converter={StaticResource MessageBoxButtonsConverter}}" />
            <Button x:Name="yesBtn"
                    Width="60"
                    Content="Yes"
                    VerticalAlignment="Stretch"
                    Command="{Binding YesCommand}"
                    Visibility="{Binding YesCommand, Converter={StaticResource MessageBoxButtonsConverter}}" />
            <Button x:Name="noBtn"
                    Width="60"
                    Content="No"
                    VerticalAlignment="Stretch"
                    Command="{Binding NoCommand}"
                    Visibility="{Binding NoCommand, Converter={StaticResource MessageBoxButtonsConverter}}" />
        </controls:UniformStackPanel>
    </Grid>
</Window>