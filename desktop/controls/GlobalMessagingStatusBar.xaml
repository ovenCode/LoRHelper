<UserControl x:Class="desktop.Controls.GlobalMessagingStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:GlobalMessagingViewModel}"
             d:DesignHeight="25"
             d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{Binding StatusMessageBackground}"
          Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
          VerticalAlignment="Bottom">
        <TextBlock Margin="5"
                   HorizontalAlignment="Center"
                   Text="{Binding Message}"
                   Foreground="{Binding StatusMessageColor}" />
    </Grid>
</UserControl>