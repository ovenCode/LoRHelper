<UserControl x:Class="desktop.pages.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:desktop.pages"
             xmlns:desktop="clr-namespace:desktop"
             xmlns:controls="clr-namespace:desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             VerticalAlignment="Stretch">
    <UserControl.Resources />
    <Grid Background="{StaticResource BackgroundColor}"
          MinHeight="450"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="profileHeaderGrid"
              Grid.Row="0"
              Background="{StaticResource PrimaryAccentGradient}"
              VerticalAlignment="Stretch">
            <TextBlock x:Name="profileNameTB"
                       HorizontalAlignment="Left"
                       Margin="30,0,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                       VerticalAlignment="Center"
                       Width="250"
                       FontSize="32"
                       FontFamily="Segoe UI Semibold"
                       Foreground="{StaticResource PrimaryTextColor}" />
        </Grid>
        <Grid Grid.Row="1"
              VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="35*"
                                  MinWidth="290" />
                <ColumnDefinition Width="55*"
                                  MinWidth="460" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="sidebarGrid"
                  VerticalAlignment="Stretch">
                <Border BorderThickness="1"
                        CornerRadius="0,6,6,0"
                        BorderBrush="{StaticResource TernaryColor}"
                        Background="{StaticResource TernaryColor}"
                        Width="66"
                        Height="242"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <StackPanel Margin="0,20,0,0">
                        <Button x:Name="profileBtn"
                                Style="{StaticResource NavigationButton}"
                                Command="{Binding ShowProfileCommand}"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Left">
                            <Image Source="../assets/icons/icon-user.png" />
                        </Button>
                        <Button x:Name="inGameBtn"
                                Style="{StaticResource NavigationButton}"
                                Command="{Binding ShowInGameCommand}"
                                CommandParameter="{Binding ShowInGameCommandParameter}"
                                Margin="12,10,0,0"
                                HorizontalAlignment="Left">
                            <Image Source="../assets/icons/icon-game.png" />
                        </Button>
                        <Button x:Name="infoBtn"
                                Style="{StaticResource NavigationButton}"
                                Command="{Binding ShowInfoCommand}"
                                Margin="12,10,0,0"
                                HorizontalAlignment="Left">
                            <Image Source="../assets/icons/icon-cards.png" />
                        </Button>
                        <Button x:Name="settingsBtn"
                                Style="{StaticResource NavigationButton}"
                                Command="{Binding ShowSettingsCommand}"
                                Margin="12,10,0,0"
                                HorizontalAlignment="Left">
                            <Image Source="../assets/icons/icon-settings.png" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="statsGrid"
                  Grid.Column="1"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch">
                <Border BorderThickness="1"
                        CornerRadius="6,6,6,6"
                        Margin="10,0"
                        Height="290"
                        Background="{StaticResource SecondaryColor}">
                    <TextBlock Text="STATY"
                               FontSize="20"
                               Foreground="White"
                               Margin="0,15,0,0"
                               HorizontalAlignment="Center" />
                </Border>
                <StackPanel x:Name="infoSP"
                            Width="150"
                            Height="200"
                            VerticalAlignment="Top"
                            Margin="0,50,0,0" />
            </Grid>
            <Grid x:Name="matchesGrid"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  Grid.Column="2">
                <StackPanel Orientation="Horizontal"
                            Height="30"
                            Margin="30,25,0,0"
                            VerticalAlignment="Top">
                    <ToggleButton x:Name="gameTypeBtn"
                                  Style="{StaticResource FilterToggleBtn}"
                                  Content="PvP"
                                  Margin="0,0,10,0" />
                    <Button x:Name="clearFiltersBtn"
                            Content="Wyczyść filtry"
                            IsEnabled="False" />
                </StackPanel>
                <ScrollViewer VerticalAlignment="Stretch"
                              Margin="0,50,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox Grid.Column="2"
                             x:Name="matchesLB"
                             Margin="0,30,0,0"
                             ClipToBounds="True"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Stretch"
                             ItemsSource="{Binding Matches}"
                             HorizontalContentAlignment="Center">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:MatchItem />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
                <Button x:Name="btnRefresh"
                        Content="Odśwież"
                        Height="30"
                        VerticalAlignment="Bottom"
                        Margin="43,0,0,20"
                        HorizontalAlignment="Left" />
                <Button x:Name="downloadBtn"
                        Content="Pobierz dane"
                        Height="30"
                        VerticalAlignment="Bottom"
                        Margin="130,0,0,20"
                        HorizontalAlignment="Left" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>