<UserControl
    x:Class="desktop.pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:desktop.pages"
    xmlns:desktop="clr-namespace:desktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <UserControl.Resources>

    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}" Height="450" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="profileHeaderGrid" Grid.Row="0" Background="{StaticResource PrimaryAccentColor}" Height="112" VerticalAlignment="Top">
            <TextBlock x:Name="profileNameTB" HorizontalAlignment="Left" Margin="30,0,0,0" TextWrapping="Wrap" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Width="250" FontSize="32" FontFamily="Segoe UI Semibold" Foreground="{StaticResource PrimaryTextColor}" />
        </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource PrimaryAccentColor}" Background="#DDDC840F" BorderThickness="0" Width="800">
            <!--<Border.Effect>
                <DropShadowEffect BlurRadius="120" Opacity=".7" ShadowDepth="8" Direction="270"/>
            </Border.Effect>-->
        </Border>
        <Grid Grid.Row="2" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.10*"/>
                <ColumnDefinition Width="0.35*"/>
                <ColumnDefinition Width="0.55*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="sidebarGrid" VerticalAlignment="Stretch">
                <Border BorderThickness="1" CornerRadius="0,6,6,0" BorderBrush="{StaticResource TernaryColor}" Background="{StaticResource TernaryColor}" Width="66" Height="242" HorizontalAlignment="Left" VerticalAlignment="Center" >
                    <StackPanel Margin="0,20,0,0">
                        <Button x:Name="profileBtn" Height="39" Width="39" Command="{Binding ShowProfileCommand}"  Background="#FF7E5110" Margin="12,0,0,0" HorizontalAlignment="Left">
                            <Image Source="../assets/icons/icon-user.png">
                            </Image>
                        </Button>
                        <Button x:Name="inGameBtn" Height="39" Width="39" Command="{Binding ShowInGameCommand}"  Background="#FF7E5110" Margin="12,10,0,0" HorizontalAlignment="Left">
                            <Image Source="../assets/icons/icon-game.png" />
                        </Button>
                        <Button x:Name="infoBtn" Height="39" Width="39" Command="{Binding ShowInfoCommand}"  Background="#FF7E5110" Margin="12,10,0,0" HorizontalAlignment="Left">
                            <Image Source="../assets/icons/icon-cards.png" />
                        </Button>
                        <Button x:Name="settingsBtn" Height="39" Width="39" Command="{Binding ShowSettingsCommand}"  Background="#FF7E5110" Margin="12,10,0,0" HorizontalAlignment="Left">
                            <Image Source="../assets/icons/icon-settings.png" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="statsGrid" Grid.Column="1" VerticalAlignment="Stretch">
                <Border BorderThickness="1" CornerRadius="6,6,6,6" Margin="10,0" Height="290" Background="{StaticResource SecondaryColor}">
                    <TextBlock Text="STATY" FontSize="20" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel x:Name="infoSP" Width="150" Height="200" VerticalAlignment="Top" Margin="0,50,0,0"/>
            </Grid>
            <Grid x:Name="matchesGrid" VerticalAlignment="Stretch" Grid.Column="2">
                <StackPanel Orientation="Horizontal" Height="25" Margin="0,25,0,0" VerticalAlignment="Top">
                    <ToggleButton x:Name="gameTypeBtn" Style="{StaticResource FilterToggleBtn}" Content="PvP" Margin="0,0,10,0" />
                    <Button x:Name="clearFiltersBtn" Content="Wyczyść filtry" IsEnabled="False" FontSize="12"/>
                </StackPanel>
                <ScrollViewer VerticalAlignment="Top" Margin="0,50,0,0" VerticalScrollBarVisibility="Auto">
                    <ListBox Grid.Column="2" x:Name="matchesLB" Width="460" Margin="0,30,0,0" ClipToBounds="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Top" ItemsSource="{Binding Matches}" HorizontalContentAlignment="Center">
                        <ListBox.ItemTemplate>
                            <desktop:MatchItem />
                        </ListBox.ItemTemplate>
                        <!-- <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                                <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                                <Setter Property="Padding" Value="2,0,0,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle> -->
                    </ListBox>
                </ScrollViewer>
                <Button x:Name="btnRefresh" Grid.Column="2" Content="Odśwież" Height="30" VerticalAlignment="Bottom" Margin="43,0,0,50" HorizontalAlignment="Left" />
                <Button x:Name="downloadBtn" Grid.Column="2" Content="Pobierz dane" Height="30" VerticalAlignment="Bottom" Margin="124,0,0,50" HorizontalAlignment="Left"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>